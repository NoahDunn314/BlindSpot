# Copy this file to .env and fill in your own values. Never commit .env.
# Placeholders only. Do not put real credentials in this file.

# demo (default, no credentials needed) or snowflake
BLINDSPOT_MODE=demo

# Snowflake connection (used only when BLINDSPOT_MODE=snowflake)
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_user
# Use one of the two authentication options below.
SNOWFLAKE_PASSWORD=your_password
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_ROLE=your_role
SNOWFLAKE_DATABASE=BLINDSPOT
SNOWFLAKE_SCHEMA=CORE

# Optional. Without a key, Blindspot shows the labeled deterministic demo explanation.
ANTHROPIC_API_KEY=your_api_key
BLINDSPOT_MODEL=claude-sonnet-5-5
